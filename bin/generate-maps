#!/usr/bin/python3
# -*- coding: utf-8 -*-

import os, sys, re
import shutil
import json
import argparse

app_dir = os.path.abspath(__file__ + "/../..")
sys.path.append(os.path.join(app_dir, "lib"))

from xcsoar.mapgen.generator import Generator
from xcsoar.mapgen.georect import GeoRect
from xcsoar.mapgen.downloader import Downloader
from xcsoar.mapgen.util import slurp


def generate_map(
    name,
    bounds,
    dir_data,
    dir_temp,
    resolution=9.0,
    level_of_detail=3,
    maplibre=False,
    dir_static=None,
    dem_arcsec=3.0,
    dem_missing_policy="fallback",
):
    output_file = name + ".xcm"
    if os.path.exists(output_file):
        return

    left = bounds[0]
    bottom = bounds[1]
    right = bounds[2]
    top = bounds[3]

    print("Generating " + output_file + " ...")
    generator = Generator(dir_data=dir_data, dir_temp=dir_temp)
    generator.set_bounds(GeoRect(left, right, top, bottom))
    generator.add_information_file(output_file, author="the XCSoar team")
    generator.add_welt2000()
    generator.add_topology(level_of_detail=level_of_detail)
    generator.add_terrain(
        resolution,
        dem_arcsec=dem_arcsec,
        dem_missing_policy=dem_missing_policy,
    )
    if maplibre:
        # Optional, additive: only ever paints a visual base map layer.
        # Terrain/topology/waypoints/airspace above are untouched.
        generator.add_maplibre(
            dir_static=dir_static or os.path.join(dir_data, "maplibre-static"),
            name=name,
            dem_arcsec=dem_arcsec,
            dem_missing_policy=dem_missing_policy,
        )
    generator.add_provenance_file()
    generator.create(output_file)
    generator.cleanup()


def generate_maps(
    name,
    bounds,
    dir_data,
    dir_temp,
    maplibre=False,
    dir_static=None,
    dem_arcsec=3.0,
    dem_missing_policy="fallback",
):
    common = dict(
        maplibre=maplibre,
        dir_static=dir_static,
        dem_arcsec=dem_arcsec,
        dem_missing_policy=dem_missing_policy,
    )
    # The two variants differ only in terrain.jp2's OUTPUT spacing; both
    # read the same source DEM tier. That distinction is the whole point of
    # dem_arcsec being separate - "_HighRes" never meant better source
    # data, only a finer output grid, and now says so.
    generate_map(name, bounds, dir_data, dir_temp, 9.0, 3, **common)
    generate_map(name + "_HighRes", bounds, dir_data, dir_temp, 3.0, 3, **common)


def main():
    parser = argparse.ArgumentParser(
        description="Batch-build all maps listed in maps.config.js"
    )
    parser.add_argument(
        "--maplibre",
        action="store_true",
        help="also build an offline MapLibre visual-basemap bundle (vector "
        "tiles + hillshade + style.json) into every .xcm file. Off by "
        "default - existing output is unaffected. Requires osmium-tool, "
        "planetiler and gdal, and a pre-fetched regional OSM extract in "
        "the data cache - see docs/DATA_SOURCES.md.",
    )
    parser.add_argument(
        "--maplibre-static",
        metavar="DIR",
        dest="maplibre_static",
        default=None,
        help="directory of job-independent MapLibre assets (style "
        "template, sprites, glyphs). Defaults to <dir_data>/maplibre-static.",
    )
    parser.add_argument(
        "--dem-arcsec",
        dest="dem_arcsec",
        choices=["auto", "1", "3"],
        default="3",
        help="SOURCE elevation data tier to read: 1 arcsec (data/dem, "
        "curated by hand, partial coverage), 3 arcsec (data/dem3, global), "
        "or auto for the best available per 1-degree cell. Default: 3. "
        "Independent of each map's output grid spacing.",
    )
    parser.add_argument(
        "--dem-missing-policy",
        dest="dem_missing_policy",
        choices=["fallback", "fail"],
        default="fallback",
        help="what to do when a 1-degree cell has no data at the tier "
        "given by --dem-arcsec: fallback (use the next-coarser tier and "
        "report it) or fail (stop, naming the missing cells). Note a batch "
        "run covers many regions, most with no 1 arcsec data at all, so "
        "'fail' with --dem-arcsec=1 will stop almost immediately. "
        "Default: fallback.",
    )
    args = parser.parse_args()

    dir_data = os.path.join(app_dir, "data")
    dir_temp = "/tmp/mapgen-{}".format(os.getpid())
    config = Downloader(dir_data).retrieve("maps.config.js")
    config = re.sub(r"var\s+MAPS\s+=\s+|;", "", slurp(config))
    maps = json.loads(config)
    try:
        for name in sorted(maps.keys()):
            generate_maps(
                name,
                maps[name],
                dir_data,
                dir_temp,
                maplibre=args.maplibre,
                dir_static=args.maplibre_static,
                dem_arcsec=(
                    None if args.dem_arcsec == "auto" else float(args.dem_arcsec)
                ),
                dem_missing_policy=args.dem_missing_policy,
            )
    finally:
        if os.path.exists(dir_temp):
            shutil.rmtree(dir_temp)


if __name__ == "__main__":
    main()
