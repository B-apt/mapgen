#!/usr/bin/python3
# -*- coding: utf-8 -*-

import sys, os
import shutil
import argparse

app_dir = os.path.abspath(__file__ + "/../..")
sys.path.append(os.path.join(app_dir, "lib"))

from xcsoar.mapgen.generator import Generator
from xcsoar.mapgen.georect import GeoRect
from xcsoar.mapgen.osm_extracts import OsmExtractCache
from xcsoar.mapgen.waypoints.parser import parse_waypoint_file


def main():
    parser = argparse.ArgumentParser(
        description="Create a custom XCM map file for XCSoar"
    )

    parser.add_argument(
        "-r",
        metavar="resolution",
        dest="resolution",
        type=float,
        default=9.0,
        help="OUTPUT resolution of terrain.jp2 in arcseconds per pixel. "
        "This is a gdalwarp output grid spacing, not a choice of source "
        "data - see --dem-arcsec for that. Clamped up if it would be "
        "finer than the source DEM actually used.",
    )
    parser.add_argument(
        "--dem-arcsec",
        dest="dem_arcsec",
        choices=["auto", "1", "3"],
        default="3",
        help="SOURCE elevation data tier to read: 1 arcsec (data/dem, "
        "curated by hand, partial coverage, cannot be downloaded), 3 "
        "arcsec (data/dem3, global, downloaded on demand), or auto for "
        "the best available per 1-degree cell. Default: 3, so the same "
        "command produces the same data on any machine.",
    )
    parser.add_argument(
        "--dem-missing-policy",
        dest="dem_missing_policy",
        choices=["fallback", "fail"],
        default="fallback",
        help="what to do when a 1-degree cell has no data at the tier "
        "given by --dem-arcsec: fallback (use the next-coarser tier and "
        "report it) or fail (stop, naming the missing cells). "
        "Default: fallback.",
    )
    parser.add_argument(
        "--max-zoom",
        dest="max_zoom",
        type=int,
        default=None,
        help="maximum zoom level for the --maplibre bundle. The hillshade "
        "layer is additionally capped by what the source DEM resolution "
        "can actually support (z12 for 3 arcsec, z14 for 1 arcsec); the "
        "provenance report states which of the two bound the result.",
    )
    parser.add_argument(
        "-l",
        metavar="level_of_detail",
        dest="level_of_detail",
        choices=[1, 2, 3],
        type=int,
        default=3,
        help="""1: only major topography,
                                2: medium level of detail,
                                3: every tiny city name and road""",
    )
    parser.add_argument(
        "-c",
        metavar="compressed",
        dest="compressed",
        action="store_const",
        const=True,
        default=False,
        help="compress topology data for smaller file size but lower speed",
    )

    parser.add_argument(
        "-w2",
        metavar="welt2000",
        dest="welt2000",
        action="store_const",
        const=True,
        default=False,
        help="create embedded waypoint file from welt2000 database",
    )

    parser.add_argument(
        "-m",
        "--maplibre",
        dest="maplibre",
        action="store_true",
        default=False,
        help="also build an offline MapLibre visual-basemap bundle (vector "
        "tiles + hillshade + style.json) into the .xcm file. Off by "
        "default - existing output is unaffected. Requires osmium-tool, "
        "planetiler and gdal on this machine; the regional OSM extract is "
        "downloaded on first use - see docs/DATA_SOURCES.md.",
    )
    parser.add_argument(
        "--maplibre-static",
        metavar="DIR",
        dest="maplibre_static",
        default=None,
        help="directory of job-independent MapLibre assets (style "
        "template, sprites, glyphs). Defaults to <data>/maplibre-static.",
    )
    parser.add_argument(
        "--no-maplibre-download",
        dest="maplibre_download",
        action="store_false",
        default=True,
        help="never fetch source data for the --maplibre bundle. The "
        "Geofabrik region(s) covering the requested bounds must then "
        "already be in <data>/osm/geofabrik/ (see bin/mapgen-osm-cache), "
        "and Planetiler's auxiliary sources in "
        "<data>/planetiler-sources/; otherwise the bundle is skipped and "
        "the reason is recorded in the provenance report.",
    )

    group = parser.add_mutually_exclusive_group(required=True)
    group.add_argument(
        "-b",
        metavar=("left", "right", "top", "bottom"),
        dest="bounds",
        type=float,
        nargs=4,
        help="boundaries of the map file",
    )
    group.add_argument(
        "-w",
        metavar="waypoint_file",
        dest="waypoint_file",
        help="a waypoint file that should be included in the map file",
    )

    parser.add_argument("output_file", help="filename of the output file")

    args = parser.parse_args()

    dir_temp = "/tmp/mapgen-{}".format(os.getpid())
    try:
        generator = Generator(dir_data=os.path.join(app_dir, "data"), dir_temp=dir_temp)
        if args.bounds:
            generator.set_bounds(
                GeoRect(args.bounds[0], args.bounds[1], args.bounds[2], args.bounds[3])
            )
        elif args.waypoint_file:
            generator.set_bounds(parse_waypoint_file(args.waypoint_file).get_bounds())
        else:
            parser.error("no map boundaries specified")

        if args.welt2000:
            generator.add_welt2000()
        elif args.waypoint_file:
            generator.add_waypoint_file(args.waypoint_file)

        dem_arcsec = None if args.dem_arcsec == "auto" else float(args.dem_arcsec)

        generator.add_information_file(args.output_file)
        generator.add_topology(
            compressed=args.compressed, level_of_detail=args.level_of_detail
        )
        generator.add_terrain(
            args.resolution,
            dem_arcsec=dem_arcsec,
            dem_missing_policy=args.dem_missing_policy,
        )
        if args.maplibre:
            # Optional, additive: only ever paints a visual base map layer.
            # Terrain/topology/waypoints/airspace above are untouched.
            dir_static = args.maplibre_static or os.path.join(
                app_dir, "data", "maplibre-static"
            )
            maplibre_args = {}
            if args.max_zoom is not None:
                maplibre_args["max_zoom"] = args.max_zoom
                maplibre_args["max_zoom_source"] = "CLI --max-zoom"
            generator.add_maplibre(
                dir_static=dir_static,
                name=args.output_file,
                dem_arcsec=dem_arcsec,
                dem_missing_policy=args.dem_missing_policy,
                osm_cache=OsmExtractCache(
                    os.path.join(app_dir, "data"),
                    allow_download=args.maplibre_download,
                ),
                allow_download=args.maplibre_download,
                **maplibre_args
            )
        generator.add_provenance_file()
        generator.create(args.output_file)
        generator.cleanup()
    finally:
        shutil.rmtree(dir_temp)


if __name__ == "__main__":
    main()
